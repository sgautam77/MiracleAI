  "@type": "sc:Dataset",
  "name": "CONUS Soil, Plant Root, and Microbial Functional AI-Ready Database",
  "description": "Harmonized, unit-standardized, quality-controlled geospatial point database of 15 topsoil (0-30 cm) physical and chemical properties (n = 50,116), C/N/P-degrading soil microbial enzyme gene relative abundances (n = 805), and plant root traits (belowground biomass and rooting depth from FRED and TRY) across the Contiguous United States (CONUS, EPSG:4326). Packaged in Apache Parquet, SQLite, and CF-1.8 NetCDF with unified 2x2-degree 5-fold spatial cross-validation splits.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "version": "1.0.0",
  "url": "https://github.com/sgautam77/MiracleAI",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "spatialCoverage": {
    "@type": "sc:Place",
    "name": "Contiguous United States (CONUS)",
    "geo": {
      "@type": "sc:GeoShape",
      "box": "24.647205 -124.680916 49.270000 -66.986809"
    }
  },
  "keywords": [
    "soil properties",
    "pedometrics",
    "rooting depth",
    "belowground biomass",
    "soil microbiome",
    "functional genes",
    "spatial cross-validation",
    "geospatial machine learning",
    "CONUS"
  ],
